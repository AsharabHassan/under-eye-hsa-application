# Copy to .env.local for local development. Names only: never commit real values.

# ── Server (never exposed to the browser) ───────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Lead delivery. Each clinic's own CRM inbound webhook (https). When the lead's
# clinic has one, the lead JSON goes there INSTEAD of GoHighLevel; when it is
# blank, the lead goes to GHL_WEBHOOK_URL exactly as before.
CRM_WEBHOOK_URL_LONDON=
CRM_WEBHOOK_URL_GLASGOW=
# GoHighLevel inbound webhook (fallback for a clinic with no CRM webhook).
GHL_WEBHOOK_URL=
# The clinic CRM's API (Harley Street Aesthetics sub-account). When
# CRM_API_KEY is set it REPLACES the GHL Private Integration below: every lead
# is upserted with its tags and answers in custom fields (lib/crm-fields.ts),
# and the report PDF is kept on the contact with a private patient link that is
# written to facial_app_report_pdf, noted and emailed from the CRM. CRM_API_BASE
# is optional (default https://app.crm.strategyguys.agency/api/v1 — keep the
# main address: clinic domains cap uploads at 5 MB); CRM_ACCOUNT defaults to
# harley-street-aesthetic. The key needs contacts.write, files.write and
# conversations.send.
CRM_API_KEY=
# CRM_API_BASE=https://app.crm.strategyguys.agency/api/v1
# CRM_ACCOUNT=harley-street-aesthetic
# GoHighLevel Private Integration: contact upsert + tags, and the PDF report.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_REPORT_FIELD_KEY=
# Own SkinScan analysis server (optional).
SKINSCAN_URL=
SKINSCAN_API_KEY=
# Meta Conversions API dataset id (optional).
META_DATASET_ID=

# ── Public (safe to expose) ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://undereye.harleystreetaesthetic.clinic
# "Contact our clinic" fallback links (not the booking calendar).
NEXT_PUBLIC_BOOKING_URL=https://harleystreetaesthetic.co.uk/london/contact/
NEXT_PUBLIC_GLASGOW_BOOKING_URL=https://harleystreetaesthetic.co.uk/glasgow/contact/
# Meta Pixel id (optional; no pixel without it).
NEXT_PUBLIC_META_PIXEL_ID=
# The booking calendar is the CRM's online booking page on
# app.harleystreetaesthetic.co.uk (CRM_BOOKING_URL in lib/constants.ts),
# embedded on the result page; it reads no prefill parameters.
# NEXT_PUBLIC_BOOKING_CALENDAR_URL and NEXT_PUBLIC_GLASGOW_BOOKING_CALENDAR_URL are no longer read.
